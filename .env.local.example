# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser.
# Used only by scripts/seed-users.mjs to create the two accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The two accounts. Local part of the email becomes the username
# (must resolve to "shab" and "soumya" — see 0002_functions_triggers.sql).
# Emails are NEXT_PUBLIC because the login screen uses them to let each
# person just tap their name instead of typing an email address — they
# are not secret, only the passwords are.
NEXT_PUBLIC_SHAB_EMAIL=shab@shabsoumya.app
SHAB_PASSWORD=change-me
NEXT_PUBLIC_SOUMYA_EMAIL=soumya@shabsoumya.app
SOUMYA_PASSWORD=change-me
